.login-page {
  min-height: 100vh;
  padding: 120rpx 60rpx;
  box-sizing: border-box;
  background: #f6f4f0;
  display: flex;
  flex-direction: column;
}

.logo {
  font-size: 96rpx;
  text-align: center;
}

.app-name {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #3a3835;
  margin-top: 16rpx;
}

.app-sub {
  text-align: center;
  font-size: 24rpx;
  color: #9a958c;
  margin: 10rpx 0 60rpx;
}

.tabs {
  position: relative;
  display: flex;
  background: #efede8;
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 40rpx;
}

/* 滑动滑块：绝对定位铺在 tab 底层，随选中项平移 */
.tab-slider {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: calc(50% - 8rpx);
  height: calc(100% - 16rpx);
  border-radius: 34rpx;
  background: #3a3835;
  transition: transform 0.3s ease;
  z-index: 1;
}

.slider-right {
  transform: translateX(100%);
}

.tab {
  position: relative;
  z-index: 2;
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #9a958c;
  padding: 16rpx 0;
  border-radius: 34rpx;
  transition: color 0.3s ease;
}

.tab.active {
  color: #ffffff;
  font-weight: 600;
}

/* 表单淡入淡出 */
.form {
  transition: opacity 0.2s ease;
}

.form-fade-out {
  opacity: 0;
}

.form:not(.form-fade-out) {
  animation: form-in 0.3s ease;
}

@keyframes form-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.input {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(58, 56, 53, 0.06);
}

.submit {
  margin-top: 12rpx;
}

.hint {
  text-align: center;
  font-size: 22rpx;
  color: #b3aea5;
  margin-top: 24rpx;
}
