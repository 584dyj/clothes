.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 汇总区：月度 + 年度并排 */
.summary {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-num {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #9a958c;
}

.summary-divider {
  width: 1rpx;
  height: 64rpx;
  background: #efede8;
}

/* 今日消费 */
.today-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  margin-bottom: 16rpx;
  background: #3a3835;
  border-radius: 16rpx;
  color: #ffffff;
}

.today-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.today-amount {
  font-size: 40rpx;
  font-weight: 600;
}

/* 月份切换：标题可点击（快速切换年月） */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 20rpx;
}

.month-nav .nav-btn {
  flex: 0 0 64rpx;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  border-radius: 50%;
  background: #ffffff;
  color: #6b675f;
  font-size: 40rpx;
  line-height: 60rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(58, 56, 53, 0.08);
}

.month-nav .nav-btn::after {
  border: none;
}

.nav-title {
  flex: 1;
  text-align: center;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 500;
}

/* 日历栅格 */
.calendar {
  padding: 16rpx 8rpx 24rpx;
}

.week-row {
  display: flex;
  margin-bottom: 8rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #9a958c;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.28%; /* 7 列 */
  height: 112rpx;
  padding: 6rpx 0;
  box-sizing: border-box;
  text-align: center;
  border-radius: 8rpx;
}

.day-empty {
  visibility: hidden;
}

.day-num {
  font-size: 28rpx;
  color: #3a3835;
}

.day-today {
  color: #c0504d;
  font-weight: 600;
}

.day-amount {
  font-size: 20rpx;
  color: #6b675f;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
}

.today-zero {
  color: #b3aea5; /* 今天无消费时弱化显示 ¥0 */
}

.day-marks {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 14rpx;
  margin-top: 4rpx;
}

.mark-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin: 0 4rpx;
}

.mark-plan {
  background: transparent;
  border: 2rpx solid #6b675f;
  box-sizing: border-box;
}

.mark-worn {
  background: #3a3835;
}

/* 开销分段 */
.segment-row {
  display: flex;
  margin-bottom: 20rpx;
}

.segment-chip {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #ffffff;
  color: #6b675f;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.segment-chip:last-child {
  margin-right: 0;
}

.segment-active {
  background: #3a3835;
  color: #ffffff;
}

.calendar-note { color: #6b675f; font-size: 24rpx; line-height: 1.6; margin-bottom: 16rpx; }
.day-selected { background: #e9e4db; }
.day-details { margin-top: 24rpx; padding: 24rpx; }
.day-item { text-align: left; font-size: 28rpx; margin-top: 12rpx; }
.plan-row { display: flex; align-items: center; }
.plan-row-main { flex: 1; min-width: 0; }
.checkin-btn { flex-shrink: 0; margin-top: 12rpx; margin-left: 16rpx; padding: 6rpx 24rpx; border-radius: 28rpx; background: #3a3835; color: #ffffff; font-size: 24rpx; line-height: 40rpx; }
.checkin-disabled { background: #efede8; color: #9a958c; }
.day-item-icon { width: 30rpx; height: 30rpx; margin-right: 10rpx; vertical-align: -6rpx; }
.details-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.details-actions { display: flex; gap: 12rpx; width: 100%; margin-top: 16rpx; }
.mini-btn { flex: 1; min-width: 0; font-size: 24rpx; color: #3a3835; background: #efede8; border-radius: 28rpx; line-height: 56rpx; padding: 0; margin: 0; }
.details-section { margin-top: 16rpx; }
.details-subtitle { font-size: 24rpx; color: #9a958c; margin-top: 8rpx; }
.expense-item { color: #6b675f; }
.plan-item { color: #3a3835; }
.wear-item { color: #6b675f; }
.nav-btn[disabled] { opacity: 0.35; }
