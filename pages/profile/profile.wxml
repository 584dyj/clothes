<view class="page">
  <view wx:if="{{loadError}}" class="empty">{{loadError}}<button bindtap="onRetry">重新加载</button></view>
  <block wx:if="{{!loadError}}">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <view class="content">
      <view class="profile-card card">
        <!-- 圆形容器由外层 view 控制，button 仅作透明点击层，避免 button 默认样式干扰 -->
        <view class="avatar-wrap">
          <image wx:if="{{avatarFileID}}" class="avatar" src="{{avatarFileID}}" mode="aspectFill" />
          <view wx:else class="avatar avatar-placeholder">{{avatarText}}</view>
          <button
            class="avatar-button"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
            disabled="{{avatarSaving}}"
          ></button>
        </view>
        <view class="profile-name">{{username}}</view>
        <view class="avatar-hint">点击头像更换</view>
      </view>

      <view class="account-card card">
        <view class="info-row">
          <text class="info-label">用户名</text>
          <text class="info-value">{{username}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">使用的注册码</text>
          <text class="info-value code-value">{{registerCode}}</text>
        </view>
      </view>
      <view class="section-title">衣橱偏好</view>
      <view class="insight-row">
        <view class="insight-card card">
          <image
            wx:if="{{mostExpensive && mostExpensive.imageFileID}}"
            class="insight-image"
            src="{{mostExpensive.imageFileID}}"
            mode="aspectFill"
          />
          <view wx:else class="insight-image insight-placeholder">¥</view>
          <view class="insight-body">
            <view class="insight-label">最贵的衣服</view>
            <view class="insight-name">{{mostExpensive ? mostExpensive.name : '暂无衣物'}}</view>
            <view wx:if="{{mostExpensive}}" class="insight-meta">¥{{mostExpensive.price}}</view>
          </view>
        </view>
        <view class="insight-card card">
          <view class="insight-image insight-placeholder brand-placeholder">{{favoriteBrand ? favoriteBrand.initial : 'B'}}</view>
          <view class="insight-body">
            <view class="insight-label">最喜欢的品牌</view>
            <view class="insight-name">{{favoriteBrand ? favoriteBrand.name : '暂无品牌'}}</view>
            <view wx:if="{{favoriteBrand}}" class="insight-meta">{{favoriteBrand.count}} 件衣物</view>
          </view>
        </view>
      </view>

      <view class="section-title">提醒</view>
      <view class="account-card card">
        <view class="info-row tappable" bindtap="onCityTap">
          <text class="info-label">城市</text>
          <text class="info-value {{cityName ? '' : 'muted'}}">{{cityName || '未设置，无法接收天气提醒'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">明日天气与穿搭</text>
          <text wx:if="{{weatherQuotaLoading}}" class="info-value muted">次数加载中…</text>
          <text wx:elif="{{weatherQuotaError}}" class="info-value tappable" bindtap="loadSubscriptionStatus">次数读取失败，点此重试</text>
          <text wx:else class="info-value">剩余 {{weatherUnused}} 次</text>
        </view>
        <view class="reminder-actions">
          <button class="btn-primary reminder-subscribe" bindtap="onSubscribeWeather" loading="{{subscribingWeather}}" disabled="{{subscribingWeather || cancelingWeather || weatherQuotaLoading || weatherQuotaError || weatherUnused >= 12}}">{{weatherUnused >= 12 ? '次数已充足' : '增加1次天气提醒'}}</button>
          <button class="btn-danger reminder-subscribe" data-scene="weather" bindtap="onCancelReminder" loading="{{cancelingWeather}}" disabled="{{subscribingWeather || cancelingWeather || weatherQuotaLoading || weatherQuotaError || weatherUnused <= 0}}">取消提醒</button>
        </view>
        <view class="reminder-hint">
          <view wx:if="{{weatherStateText}}">{{weatherStateText}}</view>
          <view>每天 21:30，为你送上明日天气与穿搭建议</view>
          <view>每次订阅可收到一条提醒，若已过今日发送时间，则顺延至明晚</view>
          <view>订阅前，请先设置城市</view>
          <view>取消提醒将清空对应的剩余次数</view>
        </view>
        <view class="info-row">
          <text class="info-label">闲置月报</text>
          <text wx:if="{{reportQuotaLoading}}" class="info-value muted">次数加载中…</text>
          <text wx:elif="{{reportQuotaError}}" class="info-value tappable" bindtap="loadSubscriptionStatus">次数读取失败，点此重试</text>
          <text wx:else class="info-value">剩余 {{reportUnused}} 次</text>
        </view>
        <view class="reminder-actions">
          <button class="btn-primary reminder-subscribe" bindtap="onSubscribeReport" loading="{{subscribingReport}}" disabled="{{subscribingReport || cancelingReport || reportQuotaLoading || reportQuotaError || reportUnused >= 12}}">{{reportUnused >= 12 ? '次数已充足' : '增加1次月报提醒'}}</button>
          <button class="btn-danger reminder-subscribe" data-scene="report" bindtap="onCancelReminder" loading="{{cancelingReport}}" disabled="{{subscribingReport || cancelingReport || reportQuotaLoading || reportQuotaError || reportUnused <= 0}}">取消提醒</button>
        </view>
        <view class="reminder-hint">
          <view>每月 1 日 09:00，为你检查闲置衣物</view>
          <view>每次授权增加 1 次，成功发送后扣除 1 次，用完后将暂停提醒</view>
          <view>取消提醒将清空对应的剩余次数</view>
        </view>
      </view>

      <block wx:if="{{hasWearRecords}}">
        <view class="section-title">穿搭记录</view>
        <view class="account-card card streak-card">
          <view class="streak-num">{{streakDays}}</view>
          <view class="streak-label">连续记录天数 · 本月打卡 {{monthCheckins}} 天</view>
        </view>
      </block>
    </view>

    <block wx:if="{{pendingCleanup}}">
      <button class="btn-danger logout-btn" bindtap="onRetryCleanup" loading="{{cleaning}}" disabled="{{cleaning}}">重试清理</button>
      <view class="cleanup-hint">部分旧图片或穿搭引用尚未清理，不影响正常使用</view>
    </block>
    <button class="btn-danger logout-btn" bindtap="onLogout" disabled="{{loggingOut}}">退出登录</button>
  </block>
  </block>
</view>
