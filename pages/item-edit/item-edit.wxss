.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.item-edit-loading {
  padding: 48rpx 0;
}

.image-box {
  width: 420rpx;
  height: 560rpx; /* 3:4 竖版，居中 */
  overflow: hidden;
  margin: 0 auto 24rpx;
}

.preview {
  width: 100%;
  height: 100%;
  display: block;
}

.image-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9a958c;
  font-size: 26rpx;
}

.plus {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.scan-btn {
  width: 420rpx;
  margin: -8rpx auto 24rpx;
  border: 1rpx solid #3a3835;
  border-radius: 999rpx;
  background: #ffffff;
  color: #3a3835;
  font-size: 28rpx;
}

.scan-btn::after {
  border: none;
}

.form {
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #efede8;
}

.field:last-child {
  border-bottom: none;
}

.field-column {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  width: 160rpx;
  color: #6b675f;
  font-size: 28rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.picker-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.placeholder {
  color: #b3aea5;
}

.season-row {
  display: flex;
  margin-top: 20rpx;
}

.season-chip {
  width: 96rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.season-active {
  background: #3a3835;
  color: #ffffff;
}

.category-row {
  width: 100%;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-row .season-chip {
  flex-shrink: 0;
  margin-right: 0;
}

.category-chip {
  width: auto;
  min-width: 112rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.textarea {
  width: 100%;
  height: 140rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-actions {
  display: flex;
  gap: 24rpx;
}

.form-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.mode-switch {
  position: relative;
  display: flex;
  margin: 0 0 24rpx;
  padding: 6rpx;
  border-radius: 36rpx;
  background: #e9e5de;
}

.mode-indicator {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  border-radius: 32rpx;
  background: #ffffff;
  transform: translateX(0);
  transition: transform 240ms ease;
}

.mode-indicator-right {
  transform: translateX(100%);
}

.mode-option {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  text-align: center;
  color: #77716a;
  font-size: 26rpx;
  transition: color 240ms ease;
}

.mode-active {
  color: #3a3835;
  font-weight: 600;
}

.mode-panel-hidden {
  display: none;
}
