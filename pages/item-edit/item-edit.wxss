.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.item-edit-loading {
  padding: 48rpx 0;
}

.image-box {
  width: 420rpx;
  height: 560rpx; /* 3:4 竖版，居中 */
  overflow: hidden;
  margin: 0 auto 24rpx;
}

.preview {
  width: 100%;
  height: 100%;
  display: block;
}

.image-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9a958c;
  font-size: 26rpx;
}

.plus {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.image-actions {
  display: flex;
  gap: 16rpx;
  width: 420rpx;
  margin: -8rpx auto 24rpx;
}

.scan-btn {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  height: 64rpx;
  line-height: 62rpx;
  box-sizing: border-box;
  border: 1rpx solid #3a3835;
  border-radius: 999rpx;
  background: #ffffff;
  color: #3a3835;
  font-size: 24rpx;
}

.scan-btn::after {
  border: none;
}

.scan-btn[disabled] { color: #9a958c; border-color: #d8d4cc; }

.form {
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}

.brand-suggestions { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 16rpx 0; }
.brand-suggestions button { margin: 0; max-width: 100%; white-space: normal; word-break: break-all; background: #efede8; color: #6b675f; }

.field {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #efede8;
}

.field:last-child {
  border-bottom: none;
}

.field-column {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  width: 160rpx;
  color: #6b675f;
  font-size: 28rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.picker-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.placeholder {
  color: #b3aea5;
}

.season-row {
  display: flex;
  margin-top: 20rpx;
}

.season-chip {
  width: 96rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.season-active {
  background: #3a3835;
  color: #ffffff;
}

.category-row {
  width: 100%;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-row .season-chip {
  flex-shrink: 0;
  margin-right: 0;
}

/* 类别：每行 4 个等宽格子，按列对齐，消除胶囊换行导致的右边缘参差 */
.category-chip {
  flex: 0 0 calc((100% - 48rpx) / 4); /* 4 列：扣掉 3 个 16rpx 间距 */
  width: auto;
  min-width: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.textarea {
  width: 100%;
  height: 140rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-actions {
  display: flex;
  gap: 24rpx;
}

.reuse-options { margin-bottom: 24rpx; color: #6b675f; font-size: 26rpx; }
.reuse-hint { margin-bottom: 12rpx; color: #9a958c; font-size: 24rpx; }
.reuse-options label { display: inline-flex; align-items: center; margin-right: 32rpx; min-height: 72rpx; }
.reuse-options checkbox { transform: scale(0.8); }

.form-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.form-locked { pointer-events: none; }
.btn-secondary {
  background: #ffffff;
  color: #3a3835;
  border: 1rpx solid #3a3835;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.btn-secondary::after { border: none; }

.mode-switch {
  position: relative;
  display: flex;
  margin: 0 0 24rpx;
  padding: 6rpx;
  border-radius: 36rpx;
  background: #e9e5de;
}

.mode-indicator {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  border-radius: 32rpx;
  background: #ffffff;
  transform: translateX(0);
  transition: transform 240ms ease;
}

.mode-indicator-right {
  transform: translateX(100%);
}

.mode-option {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  text-align: center;
  color: #77716a;
  font-size: 26rpx;
  transition: color 240ms ease;
}

.mode-active {
  color: #3a3835;
  font-weight: 600;
}

.mode-panel-hidden {
  display: none;
}
