<view class="page" bindtouchstart="onSwipeBackStart" bindtouchend="onSwipeBackEnd">
  <view wx:if="{{loading}}" class="empty item-edit-loading">加载中…</view>
  <view wx:elif="{{loadError}}" class="empty">{{loadError}}<button bindtap="onRetry">重新加载</button></view>

  <block wx:else>
    <!-- 新增时可在单件与批量之间切换 -->
    <view wx:if="{{!id}}" class="mode-switch" role="tablist" aria-label="添加方式">
      <view class="mode-indicator {{mode === 'batch' ? 'mode-indicator-right' : ''}}" aria-hidden="true"></view>
      <view class="mode-option {{mode === 'single' ? 'mode-active' : ''}}" data-mode="single" bindtap="onModeTap" role="tab" aria-selected="{{mode === 'single'}}">单件添加</view>
      <view class="mode-option {{mode === 'batch' ? 'mode-active' : ''}}" data-mode="batch" bindtap="onModeTap" role="tab" aria-selected="{{mode === 'batch'}}">批量添加</view>
    </view>

  <block wx:if="{{id || mode === 'single'}}">
  <!-- 图片 -->
  <view class="image-box card" bindtap="onChooseImage">
    <image
      wx:if="{{imagePath || imageFileID}}"
      class="preview"
      src="{{imagePath || imageFileID}}"
      mode="aspectFill"
    />
    <view wx:else class="image-placeholder">
      <view class="plus">+</view>
      <view>拍照或从相册选择</view>
    </view>
  </view>
  <button
    wx:if="{{!id && (imagePath || scanFileID)}}"
    class="scan-btn"
    bindtap="onScanPhoto"
    disabled="{{scanning || saving || !ready}}"
  >{{scanning ? '识别中…' : 'AI 识别填充'}}</button>

  <!-- 表单 -->
  <view class="form card">
    <view class="field">
      <text class="label">名称</text>
      <input class="input" placeholder="{{_focus.name ? '' : '如：白色T恤'}}" value="{{name}}" data-field="name" bindinput="onNameInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>

    <view class="field field-column">
      <text class="label">类别</text>
      <view class="season-row category-row">
        <view wx:for="{{categories}}" wx:key="*this"
          class="season-chip category-chip {{category === item ? 'season-active' : ''}}"
          data-value="{{item}}" bindtap="onCategoryTap"
        >{{item}}</view>
      </view>
    </view>

    <view class="field" wx:if="{{category === '配饰'}}" data-target="subcategory" bindtap="openPicker">
      <text class="label">配饰类型</text>
      <view class="picker-value {{subcategory ? '' : 'placeholder'}}">
        {{subcategory || '请选择配饰类型'}}
      </view>
    </view>

    <view class="field" wx:if="{{category === '鞋'}}" data-target="shoeSize" bindtap="openPicker">
      <text class="label">鞋码</text>
      <view class="picker-value {{size ? '' : 'placeholder'}}">
        {{size || '请选择鞋码'}}
      </view>
    </view>

    <view class="field field-column" wx:else>
      <text class="label">尺码</text>
      <view class="season-row category-row">
        <view wx:for="{{sizes}}" wx:key="*this"
          class="season-chip {{size === item ? 'season-active' : ''}}"
          data-value="{{item}}" bindtap="onSizeTap"
        >{{item}}</view>
      </view>
      <text wx:if="{{size && size !== 'XS' && size !== 'S' && size !== 'M' && size !== 'L' && size !== 'XL' && size !== 'F'}}" class="placeholder">原尺码：{{size}}</text>
    </view>

    <view class="field field-column">
      <text class="label">适合季节</text>
      <view class="season-row">
        <view
          wx:for="{{seasonStates}}"
          wx:key="value"
          class="season-chip {{item.active ? 'season-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onSeasonTap"
        >{{item.value}}</view>
      </view>
    </view>

    <view class="field" data-target="color" bindtap="openPicker">
      <text class="label">颜色</text>
      <view class="picker-value {{color || colorCustom ? '' : 'placeholder'}}">
        {{colorCustom ? '其他' : (color || '请选择颜色')}}
      </view>
    </view>

    <view class="field" wx:if="{{colorCustom}}">
      <text class="label">自定义颜色</text>
      <input class="input" placeholder="{{_focus.color ? '' : '输入颜色名称'}}" value="{{color}}" data-field="color" bindinput="onColorInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>

    <view class="field">
      <text class="label">品牌</text>
      <input class="input" placeholder="{{_focus.brand ? '' : '如：优衣库（可选）'}}" value="{{brand}}" data-field="brand" bindinput="onBrandInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>

    <view class="field">
      <text class="label">价格</text>
      <input class="input" type="digit" placeholder="{{_focus.price ? '' : '可选，单位：元'}}" value="{{price}}" data-field="price" bindinput="onPriceInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>

    <view class="field" data-target="date" bindtap="openPicker">
      <text class="label">购买日期</text>
      <view class="picker-value {{purchaseDate ? '' : 'placeholder'}}">
        {{purchaseDate || '可选'}}
      </view>
    </view>

    <view class="field field-column">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="{{_focus.note ? '' : '材质、购买渠道等'}}" value="{{note}}" data-field="note" bindinput="onNoteInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>
  </view>

  <view class="form-actions">
    <button class="btn-primary" bindtap="onSave" disabled="{{saving || scanning || !ready}}">保存</button>
    <button wx:if="{{id}}" class="btn-danger" bindtap="onDelete" disabled="{{saving || !ready}}">删除</button>
  </view>
  </block>

    <view wx:if="{{!id}}" class="{{mode === 'batch' ? '' : 'mode-panel-hidden'}}">
      <batch-panel />
    </view>
  </block>

  <wheel-picker
    show="{{picker.show}}"
    title="{{picker.title}}"
    columns="{{picker.columns}}"
    values="{{picker.values}}"
    bind:confirm="onPickerConfirm"
    bind:cancel="onPickerCancel"
    bind:columnchange="onPickerColumnChange"
  />
</view>
