<view class="page" bindtouchstart="onSwipeBackStart" bindtouchend="onSwipeBackEnd">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{loadError}}" class="empty">{{loadError}}<button bindtap="onRetry">重新加载</button></view>
  <!-- 穿搭照片 -->
  <view class="image-box card" bindtap="onChooseImage">
    <image
      wx:if="{{imagePath || imageFileID}}"
      class="preview"
      src="{{imagePath || imageFileID}}"
      mode="aspectFill"
    />
    <view wx:else class="image-placeholder">
      <view class="plus">+</view>
      <view>拍一张上身照（可选）</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="form card">
    <view class="field">
      <text class="label">名称</text>
      <input class="input" placeholder="{{_focus.name ? '' : '如：夏日清爽出街'}}" value="{{name}}" disabled="{{createdOutfitId}}" data-field="name" bindinput="onNameInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>
    <view class="field">
      <text class="label">场合</text>
      <view class="picker-value {{occasion ? '' : 'placeholder'}}" bindtap="openPicker">
        {{occasion || '请选择场合'}}
      </view>
    </view>
    <view class="field field-column">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="{{_focus.note ? '' : '搭配心得、适合的天气等'}}" value="{{note}}" disabled="{{createdOutfitId}}" data-field="note" bindinput="onNoteInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
    </view>
  </view>

  <!-- 选择衣物：分类切换条（单选）+ 网格 -->
  <view class="section-title">{{wearRecordId ? '本次实穿衣物' : '选择单品'}}（已选 {{selectedIds.length}} 件）</view>
  <view wx:if="{{wearRecordId}}" class="wear-hint">衣物组合已按实穿记录固定</view>
  <scroll-view wx:if="{{!wearRecordId && items.length > 0}}" scroll-x class="cat-bar" enhanced show-scrollbar="{{false}}">
    <view class="cat-bar-inner">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="cat-chip {{activeCategory === item ? 'cat-chip-active' : ''}}"
        data-value="{{item}}"
        bindtap="onCategoryTap"
      >{{item}}</view>
    </view>
  </scroll-view>
  <view wx:if="{{items.length === 0}}" class="empty">
    衣橱里还没有衣物，请先去「衣物」页添加
  </view>
  <view wx:elif="{{viewItems.length === 0}}" class="empty">
    {{activeCategory === '已选' ? '还没有选中任何单品' : '该分类下还没有衣物'}}
  </view>
  <view wx:else class="grid">
    <view
      wx:for="{{viewItems}}"
      wx:key="_id"
      class="pick-card {{item.selected ? 'pick-selected' : ''}}"
      data-id="{{item._id}}"
      bindtap="onItemToggle"
    >
      <image
        wx:if="{{item.imageFileID}}"
        class="pick-image"
        src="{{item.imageFileID}}"
        mode="aspectFill"
      />
      <view wx:else class="pick-image pick-placeholder">无图</view>
      <view class="pick-name">{{item.name}}</view>
      <view wx:if="{{item.selected}}" class="check">✓</view>
    </view>
  </view>

  <view wx:if="{{linkError}}" class="link-error">{{linkError}}</view>
  <button class="btn-primary save-btn" bindtap="onSave" disabled="{{saving || !ready}}">{{createdOutfitId ? (linkNeedsReturn ? '返回实穿' : '重试关联') : '保存'}}</button>
  <button wx:if="{{id}}" class="btn-danger delete-btn" bindtap="onDelete" disabled="{{saving || !ready}}">删除</button>

  <wheel-picker
    show="{{picker.show}}"
    title="{{picker.title}}"
    columns="{{picker.columns}}"
    values="{{picker.values}}"
    bind:confirm="onPickerConfirm"
    bind:cancel="onPickerCancel"
  />
</view>
