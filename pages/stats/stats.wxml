<view class="page">
  <view wx:if="{{loadError}}" class="empty">{{loadError}}<button bindtap="onRetry">重新加载</button></view>
  <block wx:if="{{!loadError}}">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <!-- 总览：衣物总数 + 穿搭套数一行 -->
    <view class="overview">
      <view class="overview-card card">
        <view class="overview-num">{{totalItems}}</view>
        <view class="overview-label">衣物总数</view>
      </view>
      <view class="overview-card card">
        <view class="overview-num">{{totalOutfits}}</view>
        <view class="overview-label">穿搭套数</view>
      </view>
      <view class="overview-card card">
        <view class="overview-num">{{totalBrands}}</view>
        <view class="overview-label">品牌数量</view>
      </view>
    </view>

    <!-- 分类统计：合并总花费、分类件数与衣物金额 -->
    <view class="section card">
      <view class="stats-heading">
        <view class="section-title">分类统计</view>
        <view class="calendar-link" bindtap="onCalendarTap" hover-class="calendar-link-active" aria-role="button" aria-label="查看开销月历">开销月历 ›</view>
      </view>
      <view class="spent-summary">
        <view class="spent-summary-main">
          <text class="spent-label">衣物购置</text>
          <text class="spent-num">¥{{itemSpent}}</text>
        </view>
        <view class="spent-breakdown" wx:if="{{expenseTotal > 0}}">含账本后总花费 ¥{{totalSpent}}</view>
      </view>
      <block wx:for="{{categoryStats}}" wx:key="name">
        <view wx:if="{{item.count > 0 || item.spent > 0}}" class="spent-row">
          <view class="spent-row-main">
            <text class="spent-name">{{item.name}}</text>
            <text class="spent-meta">{{item.count}}件 · {{item.percent}}%</text>
          </view>
          <text class="spent-value {{item.spent ? '' : 'spent-zero'}}">¥{{item.spent}}</text>
        </view>
      </block>
      <view wx:if="{{totalItems === 0}}" class="category-empty">还没有衣物记录</view>
      <view wx:elif="{{emptyCategoryCount > 0}}" class="category-empty">其余{{emptyCategoryCount}}个分类暂无衣物</view>
    </view>

    <!-- 账本开销分布（有账本记录才显示） -->
    <view class="section card" wx:if="{{expenseTotal > 0}}">
      <view class="section-title">账本开销 · ¥{{expenseTotal}}</view>
      <view wx:for="{{expenseStats}}" wx:key="name" class="bar-row">
        <text class="bar-label">{{item.name}}</text>
        <view class="bar-track" aria-hidden="true"><view class="bar-fill" style="{{item.barStyle}}"></view></view>
        <text class="bar-count">¥{{item.amount}}</text>
      </view>
    </view>

    <!-- 品牌分布 -->
    <view class="section card" wx:if="{{brandStats.length > 0}}">
      <view class="section-title">品牌分布</view>
      <view wx:for="{{brandStats}}" wx:key="name" class="bar-row barless-row">
        <text class="bar-label">{{item.name}}</text>
        <text class="bar-count">{{item.percent}}%（{{item.count}}件）</text>
      </view>
    </view>

    <!-- 穿着频次 / 闲置 -->
<!-- 穿着频次 / 闲置 -->
    <view class="section card">
      <view class="section-title">穿着与闲置</view>
      <view wx:if="{{wearRank.length > 0}}">
        <view wx:for="{{wearRank}}" wx:key="name" class="wear-row">
          <text class="wear-label">{{item.name}}</text>
          <text class="wear-count">{{item.count}}次</text>
        </view>
      </view>
      <view wx:if="{{idleRank.length > 0}}">
        <view wx:for="{{idleRank}}" wx:key="name" class="idle-row">
          <text class="bar-label">{{item.name}}</text>
        </view>
      </view>
      <view wx:if="{{idleInsufficient}}" class="wear-empty">
        近期无实穿或搭配记录，暂不判定闲置
      </view>
      <view wx:elif="{{wearRank.length === 0 && idleRank.length === 0}}" class="wear-empty">
        记录穿着后可查看频次与闲置情况
      </view>
    </view>

    <!-- 搭配频次（无搭配时整块隐藏） -->
    <view class="section card" wx:if="{{outfitRank.length > 0}}">
      <view class="section-title">常被搭配</view>
      <view wx:for="{{outfitRank}}" wx:key="name" class="bar-row barless-row">
        <text class="bar-label">{{item.name}}</text>
        <text class="bar-count">{{item.count}}套</text>
      </view>
    </view>

    <!-- 季节分布 -->
    <view class="section card">
      <view class="section-title">季节分布</view>
      <view class="season-grid">
        <view wx:for="{{seasonStats}}" wx:key="name" class="season-cell">
          <view class="season-num">{{item.count}}</view>
          <view class="season-name">{{item.name}}</view>
        </view>
      </view>
    </view>

  </block>
  </block>
</view>
