<view class="page">
  <view wx:if="{{loadError}}" class="empty">{{loadError}}<button bindtap="onRetry">重新加载</button></view>
  <block wx:if="{{!loadError}}">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <!-- 总览：衣物总数 + 穿搭套数一行 -->
    <view class="overview">
      <view class="overview-card card">
        <view class="overview-num">{{totalItems}}</view>
        <view class="overview-label">衣物总数</view>
      </view>
      <view class="overview-card card">
        <view class="overview-num">{{totalOutfits}}</view>
        <view class="overview-label">穿搭套数</view>
      </view>
      <view class="overview-card card">
        <view class="overview-num">{{totalBrands}}</view>
        <view class="overview-label">品牌数量</view>
      </view>
    </view>

    <!-- 总花费（单独一行，点击进入月历）+ 各分类花费 -->
    <view class="section card" bindtap="onCalendarTap">
      <view class="spent-total">
        <view class="spent-num">¥{{totalSpent}}</view>
        <view class="spent-label">总花费 · 月历 ›</view>
      </view>
      <view wx:for="{{categoryStats}}" wx:key="name" class="spent-row">
        <text class="spent-name">{{item.name}}</text>
        <text class="spent-value">¥{{item.spent}}</text>
      </view>
    </view>

    <!-- 类别分布（全部类别） -->
    <view class="section card">
      <view class="section-title">类别分布</view>
      <view wx:for="{{categoryStats}}" wx:key="name" class="bar-row">
        <text class="bar-label">{{item.name}}</text>
        <view class="bar-track" aria-hidden="true"><view class="bar-fill" style="width: {{item.percent}}%;"></view></view>
        <text class="bar-count">{{item.percent}}%（{{item.count}}件）</text>
      </view>
    </view>

    <!-- 账本开销分布（有账本记录才显示） -->
    <view class="section card" wx:if="{{expenseTotal > 0}}">
      <view class="section-title">账本开销 · ¥{{expenseTotal}}</view>
      <view wx:for="{{expenseStats}}" wx:key="name" class="bar-row">
        <text class="bar-label">{{item.name}}</text>
        <view class="bar-track" aria-hidden="true"><view class="bar-fill" style="width: {{item.percent}}%;"></view></view>
        <text class="bar-count">¥{{item.amount}}</text>
      </view>
    </view>

    <!-- 品牌分布 -->
    <view class="section card" wx:if="{{brandStats.length > 0}}">
      <view class="section-title">品牌分布</view>
      <view wx:for="{{brandStats}}" wx:key="name" class="bar-row">
        <text class="bar-label">{{item.name}}</text>
        <view class="bar-track" aria-hidden="true"><view class="bar-fill" style="width: {{item.percent}}%;"></view></view>
        <text class="bar-count">{{item.percent}}%（{{item.count}}件）</text>
      </view>
    </view>

    <!-- 穿着频次 / 闲置 -->
    <view class="section card">
      <view class="section-head">
        <view class="section-title">穿着与闲置</view>
        <text class="section-link" bindtap="onWearRecordsTap">实穿记录 ›</text>
      </view>
      <view wx:if="{{wearRank.length > 0}}">
        <view class="subsection-title">穿得最多</view>
        <view wx:for="{{wearRank}}" wx:key="name" class="bar-row">
          <text class="bar-label">{{item.name}}</text>
          <view class="bar-track" aria-hidden="true"><view class="bar-fill" style="width: {{100 * item.count / wearRank[0].count}}%;"></view></view>
          <text class="bar-count">{{item.count}}次</text>
        </view>
      </view>
      <view wx:if="{{idleRank.length > 0}}">
        <view class="subsection-title">近 90 天未记录穿着或搭配</view>
        <view wx:for="{{idleRank}}" wx:key="name" class="idle-row">
          <text class="bar-label">{{item.name}}</text>
        </view>
      </view>
      <view wx:if="{{idleInsufficient}}" class="wear-empty">近期无实穿或搭配记录，暂不判定闲置</view>
      <view wx:elif="{{wearRank.length === 0 && idleRank.length === 0}}" class="wear-empty">记录穿着后可查看频次与闲置情况</view>
    </view>

    <!-- 搭配频次（无搭配时整块隐藏） -->
    <view class="section card" wx:if="{{outfitRank.length > 0}}">
      <view class="section-title">常被搭配</view>
      <view wx:for="{{outfitRank}}" wx:key="name" class="bar-row">
        <text class="bar-label">{{item.name}}</text>
        <view class="bar-track" aria-hidden="true"><view class="bar-fill" style="width: {{100 * item.count / outfitRank[0].count}}%;"></view></view>
        <text class="bar-count">{{item.count}}套</text>
      </view>
    </view>

    <!-- 季节分布 -->
    <view class="section card">
      <view class="section-title">季节分布</view>
      <view class="season-grid">
        <view wx:for="{{seasonStats}}" wx:key="name" class="season-cell">
          <view class="season-num">{{item.count}}</view>
          <view class="season-name">{{item.name}}</view>
        </view>
      </view>
    </view>

  </block>
  </block>
</view>
