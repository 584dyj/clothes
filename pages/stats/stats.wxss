.page {
  padding: 24rpx;
}

.overview {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.overview-card {
  width: 31%;
  padding: 32rpx 0;
  text-align: center;
}

.overview-num {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.overview-label {
  font-size: 24rpx;
  color: #9a958c;
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 分类统计 */
.stats-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.stats-heading .section-title {
  margin-bottom: 0;
}

.calendar-link {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding-left: 16rpx;
  font-size: 24rpx;
  color: #9a958c;
}

.calendar-link-active {
  opacity: 0.6;
}

.spent-summary {
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
  background: #f7f5f1;
}

.spent-summary-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.spent-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #3a3835;
}

.spent-label {
  font-size: 24rpx;
  color: #9a958c;
}

.spent-breakdown {
  margin-top: 6rpx;
  text-align: right;
  font-size: 22rpx;
  color: #9a958c;
}

.spent-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 0 4rpx;
  border-bottom: 1rpx solid #f2f0ec;
  font-size: 26rpx;
  color: #6b675f;
}

.spent-row:last-child {
  border-bottom: 0;
}

.spent-row-main {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.spent-name {
  color: #6b675f;
}

.spent-meta {
  margin-left: 16rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9a958c;
  white-space: nowrap;
}

.spent-value {
  flex-shrink: 0;
  margin-left: 24rpx;
  color: #3a3835;
  font-weight: 500;
  white-space: nowrap;
}

.spent-zero {
  color: #b5b0a7;
  font-weight: 400;
}

.category-empty {
  padding: 20rpx 8rpx 2rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b5b0a7;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.bar-label {
  width: 110rpx;
  font-size: 26rpx;
  color: #6b675f;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-track {
  flex: 1;
  min-width: 0;
  height: 24rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #efede8;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  background: #3a3835;
}

.bar-count {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b675f;
  flex-shrink: 0;
}

.barless-row .bar-label {
  width: auto;
  flex: 1;
  min-width: 0;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  word-break: break-all;
}

.barless-row .bar-count {
  margin-left: 24rpx;
}

.season-grid {
  display: flex;
}

.season-cell {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.season-num {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.season-name {
  font-size: 26rpx;
  color: #9a958c;
}

.idle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #efede8;
}

.idle-row:last-child {
  border-bottom: none;
}

/* 闲置清单没有条形图，名称占满整行，超长才省略 */
.idle-row .bar-label {
  flex: 1;
  width: auto;
  min-width: 0;
}

.wear-empty {
  color: #9a958c;
  font-size: 24rpx;
  text-align: center;
}


/* 穿着与闲置：独立布局，不影响其他进度条 */

/* 每行左右分布 */
.wear-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 左侧衣物名称 */
.wear-label {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #6b675f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧穿着次数 */
.wear-count {
  flex-shrink: 0;
  margin-left: 24rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b675f;
}
