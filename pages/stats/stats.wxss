.page {
  padding: 24rpx;
}

.overview {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.overview-card {
  width: 31%;
  padding: 32rpx 0;
  text-align: center;
}

.overview-num {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.overview-label {
  font-size: 24rpx;
  color: #9a958c;
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 总花费区 */
.spent-total {
  text-align: center;
  padding-bottom: 24rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #efede8;
}

.spent-num {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.spent-label {
  font-size: 24rpx;
  color: #9a958c;
}

.spent-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 8rpx;
  font-size: 26rpx;
  color: #6b675f;
}

.spent-value {
  color: #3a3835;
  font-weight: 500;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.bar-label {
  width: 100rpx;
  font-size: 26rpx;
  color: #6b675f;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-track {
  flex: 1;
  min-width: 0;
  height: 24rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #efede8;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  background: #3a3835;
}

.bar-count {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b675f;
  flex-shrink: 0;
}

.season-grid {
  display: flex;
}

.season-cell {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.season-num {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.season-name {
  font-size: 26rpx;
  color: #9a958c;
}

.subsection-title {
  font-size: 26rpx;
  color: #9a958c;
  margin: 20rpx 0 8rpx;
}

.idle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #efede8;
}

.idle-row:last-child {
  border-bottom: none;
}

/* 闲置清单没有条形图，名称占满整行，超长才省略 */
.idle-row .bar-label {
  flex: 1;
  width: auto;
  min-width: 0;
}

.wear-empty {
  color: #9a958c;
  font-size: 24rpx;
  text-align: center;
}
