.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.toolbar-title {
  font-size: 32rpx;
  font-weight: 600;
}

.toolbar-hint, .summary-meta {
  margin-top: 8rpx;
  color: #9a958c;
  font-size: 24rpx;
}

.choose-btn {
  margin: 0;
  background: #3a3835;
  color: #ffffff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.batch-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.batch-card {
  width: 48.5%;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.card-expanded {
  width: 100%;
}

.card-summary {
  display: flex;
  padding: 16rpx;
}

.card-image {
  width: 128rpx;
  height: 170rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: #efede8;
}

.summary-text {
  min-width: 0;
  padding-left: 16rpx;
}

.summary-name {
  overflow: hidden;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  display: inline-block;
  margin-top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 22rpx;
}

.status-failed, .card-error { color: #c0504d; }
.status-saved { color: #397d4d; }

.card-error {
  padding: 0 16rpx 16rpx;
  font-size: 24rpx;
}

.card-actions {
  padding: 0 16rpx 16rpx;
}

.card-actions button {
  margin: 0;
}

.editor {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #efede8;
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #efede8;
}

.field-column {
  align-items: flex-start;
  flex-direction: column;
}

.label {
  width: 160rpx;
  flex-shrink: 0;
  color: #6b675f;
}

.input { flex: 1; }

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 25rpx;
}

.chip-active {
  background: #3a3835;
  color: #ffffff;
}

.placeholder { color: #b3aea5; }

.remove-btn {
  margin-top: 24rpx;
  color: #c0504d;
  background: #ffffff;
  font-size: 26rpx;
}

.save-btn { margin-top: 20rpx; }
