<view class="page">
  <view wx:if="{{loadError}}" class="empty">{{loadError}}<button bindtap="onRetry">重新加载</button></view>
  <block wx:if="{{!loadError}}">
    <view class="mode-switch" role="tablist" aria-label="助手功能">
      <view class="mode-indicator {{activeMode === 'purchase' ? 'mode-indicator-right' : ''}}" aria-hidden="true"></view>
      <view class="mode-option {{activeMode === 'outfit' ? 'mode-active' : ''}}" data-mode="outfit" bindtap="onModeTap" role="tab" aria-selected="{{activeMode === 'outfit'}}">穿搭推荐</view>
      <view class="mode-option {{activeMode === 'purchase' ? 'mode-active' : ''}}" data-mode="purchase" bindtap="onModeTap" role="tab" aria-selected="{{activeMode === 'purchase'}}">购买评估</view>
    </view>

    <block wx:if="{{activeMode === 'outfit'}}">
      <scroll-view scroll-x class="session-bar" enhanced show-scrollbar="{{false}}">
        <view class="session-inner">
          <view wx:for="{{visibleSessions}}" wx:key="_id" class="session-chip {{currentId === item._id ? 'session-active' : ''}}"
            data-id="{{item._id}}" bindtap="onSessionTap" bindlongpress="onSessionLongPress"
            aria-label="{{item.title}}，双击改名，长按删除会话">
            <text class="session-title">{{item.title}}</text>
          </view>
          <view class="session-chip {{currentId === '' ? 'session-active' : ''}}" data-id="new" bindtap="onSessionTap">{{currentId ? '＋ 新对话' : messages.length ? '新对话进行中' : '＋ 新对话'}}</view>
        </view>
      </scroll-view>
    </block>

    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <block wx:else>
      <scroll-view wx:if="{{activeMode === 'purchase'}}" scroll-y class="purchase-scroll">
        <view wx:if="{{!purchaseResult}}" class="purchase-card">
          <view class="purchase-title">这件衣服值得买吗？</view>
          <view class="purchase-sub">根据衣橱重复度、搭配空间和当月开销给出评估</view>

          <view class="field-label">照片识别 <text class="field-optional">选填</text></view>
          <view wx:if="{{purchaseImagePath || purchaseScanFileID}}" class="purchase-photo-preview-wrap">
            <image class="purchase-photo-preview" src="{{purchaseImagePath || purchaseScanFileID}}" mode="aspectFill" bindtap="onPreviewPurchasePhoto" />
            <view class="image-remove" bindtap="onRemovePurchasePhoto">×</view>
          </view>
          <view class="purchase-photo-actions">
            <view class="purchase-photo-action {{purchaseScanning ? 'send-disabled' : ''}}" bindtap="onPurchaseTakePhoto" role="button">拍照识别</view>
            <view class="purchase-photo-action {{purchaseScanning ? 'send-disabled' : ''}}" bindtap="onPurchaseChooseAlbum" role="button">相册识别</view>
            <view wx:if="{{purchaseImagePath || purchaseScanFileID}}" class="purchase-photo-action {{purchaseScanning ? 'send-disabled' : ''}}" bindtap="onPurchaseScanPhoto" role="button">{{purchaseScanning ? '识别中…' : '重试识别'}}</view>
          </view>
          <view class="purchase-photo-hint">识别结果只填充空白项，提交评估前仍可修改。</view>

          <view class="field-label">名称 <text class="field-optional">选填</text></view>
          <input class="purchase-input" value="{{purchaseForm.name}}" maxlength="60" data-field="name" bindinput="onPurchaseFieldInput" placeholder="例如：蓝色牛仔外套" />

          <view class="field-label">分类</view>
          <view class="choice-row">
            <view wx:for="{{categories}}" wx:key="*this" class="choice {{purchaseForm.category === item ? 'choice-active' : ''}}" data-value="{{item}}" bindtap="onPurchaseCategoryTap">{{item}}</view>
          </view>

          <block wx:if="{{purchaseForm.category === '配饰'}}">
            <view class="field-label">配饰类型</view>
            <view class="choice-row">
              <view wx:for="{{accessoryTypes}}" wx:key="*this" class="choice {{purchaseForm.subcategory === item ? 'choice-active' : ''}}" data-value="{{item}}" bindtap="onPurchaseSubcategoryTap">{{item}}</view>
            </view>
          </block>

          <view class="field-label">适合季节</view>
          <view class="choice-row">
            <view wx:for="{{seasonOptions}}" wx:key="value" class="choice {{item.selected ? 'choice-active' : ''}}" data-value="{{item.value}}" bindtap="onPurchaseSeasonTap">{{item.value}}</view>
          </view>

          <view class="purchase-grid">
            <view class="purchase-grid-item">
              <view class="field-label">颜色</view>
              <picker range="{{colors}}" bindchange="onPurchaseColorChange">
                <view class="purchase-picker {{purchaseForm.color ? '' : 'purchase-placeholder'}}">{{purchaseForm.color || '请选择'}}</view>
              </picker>
            </view>
            <view class="purchase-grid-item">
              <view class="field-label">价格</view>
              <input class="purchase-input" type="digit" value="{{purchaseForm.price}}" data-field="price" bindinput="onPurchaseFieldInput" placeholder="元" />
            </view>
          </view>

          <view class="purchase-grid">
            <view class="purchase-grid-item">
              <view class="field-label">主要场合 <text class="field-optional">选填</text></view>
              <picker range="{{occasions}}" bindchange="onPurchaseOccasionChange">
                <view class="purchase-picker {{purchaseForm.occasion ? '' : 'purchase-placeholder'}}">{{purchaseForm.occasion || '请选择'}}</view>
              </picker>
            </view>
            <view class="purchase-grid-item">
              <view class="field-label">月预算 <text class="field-optional">选填</text></view>
              <input class="purchase-input" type="digit" value="{{purchaseForm.monthlyBudget}}" data-field="monthlyBudget" bindinput="onPurchaseFieldInput" placeholder="元" />
            </view>
          </view>

          <view class="field-label">备注 <text class="field-optional">选填</text></view>
          <textarea class="purchase-textarea" value="{{purchaseForm.note}}" maxlength="200" data-field="note" bindinput="onPurchaseFieldInput" placeholder="版型、材质或购买顾虑" />
          <view wx:if="{{purchaseError}}" class="purchase-error">{{purchaseError}}</view>
          <view class="purchase-submit {{purchaseAssessing || purchaseScanning ? 'send-disabled' : ''}}" bindtap="onPurchaseSubmit" role="button">{{purchaseAssessing ? '正在评估…' : purchaseScanning ? '正在识别…' : '开始评估'}}</view>
        </view>

        <view wx:else class="purchase-card result-card">
          <view class="verdict verdict-{{purchaseVisualReview ? purchaseVisualReview.finalVerdict.code : purchaseResult.verdict.code}}">{{purchaseVisualReview ? purchaseVisualReview.finalVerdict.label : purchaseResult.verdict.label}}</view>
          <view wx:if="{{purchaseVisualLoading}}" class="visual-review visual-loading">AI 视觉复核中…</view>
          <view wx:elif="{{purchaseVisualReview}}" class="visual-review">
            <view class="visual-title">AI 视觉复核</view>
            <view wx:if="{{purchaseVisualReview.ruleVerdict.code !== purchaseVisualReview.finalVerdict.code}}" class="visual-verdicts">
              <text>规则基准：{{purchaseVisualReview.ruleVerdict.label}}</text>
              <text>调整后：{{purchaseVisualReview.finalVerdict.label}}</text>
            </view>
            <view wx:else class="visual-verdicts"><text>结论维持：{{purchaseVisualReview.finalVerdict.label}}</text></view>
            <view class="visual-reason">{{purchaseVisualReview.reason}}</view>
            <view class="visual-count">已对比 {{purchaseVisualReview.comparedCount}} 件现有衣物</view>
          </view>
          <view wx:if="{{purchaseResult.modelAdvice}}" class="model-advice">
            <view class="model-summary">{{purchaseResult.modelAdvice.summary}}</view>
            <view class="model-advice-text">{{purchaseResult.modelAdvice.advice}}</view>
          </view>
          <view class="result-reason" wx:for="{{purchaseResult.reasons}}" wx:key="*this">{{index + 1}}. {{item}}</view>
          <view class="result-metrics">
            <view><text>重复风险</text><text>{{purchaseResult.duplicateRisk.label}}</text></view>
            <view wx:if="{{purchaseResult.matchCount !== null}}"><text>可搭配衣物</text><text>{{purchaseResult.matchCount}} 件</text></view>
            <view><text>本月已开销</text><text>¥{{purchaseResult.spending.monthSpent}}</text></view>
            <view><text>购买后开销</text><text>¥{{purchaseResult.spending.afterPurchase}}</text></view>
          </view>
          <view wx:if="{{purchaseResult.similarItems.length}}" class="similar-block">
            <view class="field-label">相似衣物</view>
            <view class="similar-item" wx:for="{{purchaseResult.similarItems}}" wx:key="id">
              <text>{{item.name}} · {{item.color}}</text><text>近 90 天 {{item.wearCount90}} 次</text>
            </view>
          </view>
          <view wx:if="{{purchaseResult.truncated}}" class="purchase-note">衣橱超过 120 件，缺口判断已关闭，避免误判。</view>
          <view wx:if="{{purchaseError}}" class="purchase-error">{{purchaseError}}</view>
          <view class="purchase-result-actions">
            <view class="purchase-submit purchase-submit-secondary" bindtap="onPurchaseEdit" role="button">修改条件</view>
            <view class="purchase-submit" bindtap="onPurchaseRestart" role="button">重新评估</view>
          </view>
        </view>
        <view class="purchase-bottom-space"></view>
      </scroll-view>

      <block wx:else>
        <scroll-view scroll-y class="chat-scroll" scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
          <view wx:if="{{messages.length === 0}}" class="chat-empty">
            <view class="chat-empty-title">我是你的穿搭助手</view>
            <view class="chat-empty-sub">可以问我搭配建议，也可以拍照或从衣橱选一件单品</view>
            <view class="suggestion" data-text="根据我的衣橱推荐一套通勤穿搭" bindtap="onSuggestionTap">根据我的衣橱推荐一套通勤穿搭</view>
          </view>
          <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}" class="msg-row {{item.role === 'user' ? 'msg-user' : 'msg-assistant'}}">
            <view class="bubble">
              <image wx:if="{{item.imageFileID}}" class="bubble-img" src="{{item.imageFileID}}" mode="aspectFill" data-fileid="{{item.imageFileID}}" bindtap="onPreviewImage" />
              <text wx:if="{{item.text}}" class="bubble-text">{{item.displayText}}</text>
            </view>
          </view>
          <view wx:if="{{awaitingReply && !streaming}}" id="msg-thinking" class="msg-row msg-assistant"><view class="bubble bubble-thinking">{{thinkingText}}</view></view>
          <view wx:if="{{sendError}}" class="send-error">{{sendError}}</view>
          <view id="msg-end" style="height: 8rpx;"></view>
        </scroll-view>

        <view class="input-bar">
          <view wx:if="{{selectedItemId}}" class="selected-item-wrap">
            <view class="selected-item">衣橱 · {{selectedItemName}}</view>
            <view class="selected-item-remove" bindtap="onRemoveSelectedItem">×</view>
          </view>
          <view wx:if="{{imagePath}}" class="image-preview-wrap">
            <image class="image-preview" src="{{imagePath}}" mode="aspectFill" bindtap="onPreviewSelectedImage" />
            <view class="image-remove" bindtap="onRemoveImage">×</view>
          </view>
          <view class="input-row">
            <view class="image-btn" bindtap="onChooseImage" role="button" aria-label="添加图片或选择衣橱单品">
              <image class="image-icon" src="/assets/icons/image.svg" mode="aspectFit" />
            </view>
            <input class="chat-input" value="{{input}}" disabled="{{sending}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" placeholder="问穿搭，或选择图片、衣橱单品" />
            <view class="send-btn {{sending || !canSend ? 'send-disabled' : ''}}" bindtap="onSend">发送</view>
          </view>
        </view>
      </block>
    </block>
  </block>

  <wheel-picker
    show="{{itemPicker.show}}"
    title="{{itemPicker.title}}"
    columns="{{itemPicker.columns}}"
    values="{{itemPicker.values}}"
    bind:confirm="onItemPickerConfirm"
    bind:cancel="onItemPickerCancel"
  />
</view>
