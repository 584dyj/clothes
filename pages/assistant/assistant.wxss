.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f4f0;
  box-sizing: border-box;
}

.mode-switch {
  display: flex;
  margin: 18rpx 24rpx 8rpx;
  padding: 6rpx;
  border-radius: 36rpx;
  background: #e9e5de;
  flex-shrink: 0;
}

.mode-option {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  text-align: center;
  color: #77716a;
  font-size: 26rpx;
}

.mode-active {
  background: #ffffff;
  color: #3a3835;
  font-weight: 600;
}

.session-bar {
  width: 100%;
  white-space: nowrap;
  background: #ffffff;
  box-sizing: border-box;
  flex-shrink: 0;
}

.session-inner {
  display: inline-flex;
  padding: 16rpx 20rpx;
}

.session-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 24rpx;
  white-space: nowrap;
}

.session-title {
  display: inline-block;
  max-width: 210rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-active {
  background: #3a3835;
  color: #ffffff;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
}

.chat-empty {
  padding: 80rpx 24rpx 40rpx;
  text-align: center;
}

.chat-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3a3835;
}

.chat-empty-sub {
  font-size: 24rpx;
  color: #9a958c;
  margin-top: 12rpx;
  line-height: 1.6;
}

.suggestion {
  display: inline-block;
  margin-top: 24rpx;
  max-width: 90%;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #3a3835;
  font-size: 26rpx;
  border: 1rpx solid #e4e0d8;
}

.purchase-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.purchase-card {
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.purchase-title {
  color: #3a3835;
  font-size: 34rpx;
  font-weight: 600;
}

.purchase-sub {
  margin-top: 10rpx;
  color: #8b857c;
  font-size: 24rpx;
  line-height: 1.5;
}

.purchase-photo-preview-wrap {
  position: relative;
  width: 180rpx;
}

.purchase-photo-preview {
  display: block;
  width: 180rpx;
  height: 220rpx;
  border-radius: 16rpx;
}

.purchase-photo-actions {
  display: flex;
  flex-wrap: wrap;
  margin: 14rpx -6rpx 0;
}

.purchase-photo-action {
  margin: 6rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid #d8d3ca;
  border-radius: 28rpx;
  color: #514d47;
  font-size: 24rpx;
}

.purchase-photo-hint {
  margin-top: 10rpx;
  color: #aaa49b;
  font-size: 22rpx;
  line-height: 1.5;
}

.field-label {
  margin: 28rpx 0 12rpx;
  color: #3a3835;
  font-size: 26rpx;
  font-weight: 600;
}

.field-optional {
  color: #aaa49b;
  font-size: 22rpx;
  font-weight: 400;
}

.purchase-input,
.purchase-picker,
.purchase-textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 16rpx;
  background: #f6f4f0;
  color: #3a3835;
  font-size: 26rpx;
}

.purchase-input,
.purchase-picker {
  height: 76rpx;
  padding: 0 22rpx;
  line-height: 76rpx;
}

.purchase-placeholder {
  color: #aaa49b;
}

.purchase-textarea {
  height: 150rpx;
  padding: 20rpx 22rpx;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.choice {
  margin: 6rpx;
  padding: 12rpx 22rpx;
  border-radius: 28rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 24rpx;
}

.choice-active {
  background: #3a3835;
  color: #ffffff;
}

.purchase-grid {
  display: flex;
  margin: 0 -8rpx;
}

.purchase-grid-item {
  flex: 1;
  min-width: 0;
  margin: 0 8rpx;
}

.purchase-submit {
  height: 76rpx;
  margin-top: 28rpx;
  border-radius: 38rpx;
  background: #3a3835;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
  text-align: center;
}

.purchase-error,
.purchase-note {
  margin-top: 20rpx;
  color: #b1433f;
  font-size: 24rpx;
  line-height: 1.5;
}

.purchase-note {
  color: #8b857c;
}

.verdict {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.verdict-buy { background: #e2efe5; color: #39704a; }
.verdict-consider { background: #f4ead4; color: #8a6326; }
.verdict-skip { background: #f4dfdd; color: #9b443f; }

.model-advice {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
}

.model-summary {
  color: #3a3835;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.model-advice-text {
  margin-top: 8rpx;
  color: #68625a;
  font-size: 24rpx;
  line-height: 1.6;
}

.result-reason {
  margin-top: 18rpx;
  color: #514d47;
  font-size: 26rpx;
  line-height: 1.5;
}

.result-metrics {
  margin-top: 26rpx;
  padding: 8rpx 22rpx;
  border-radius: 18rpx;
  background: #f6f4f0;
}

.result-metrics view,
.similar-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  color: #68625a;
  font-size: 24rpx;
  border-bottom: 1rpx solid #e8e3db;
}

.result-metrics view:last-child,
.similar-item:last-child {
  border-bottom: 0;
}

.purchase-bottom-space { height: 36rpx; }

.msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 76%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: #efede8;
  color: #3a3835;
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-user .bubble {
  background: #3a3835;
  color: #ffffff;
}

.bubble-text {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-img {
  width: 300rpx;
  height: 400rpx;
  border-radius: 12rpx;
  display: block;
  margin-bottom: 12rpx;
}

.bubble-thinking {
  color: #9a958c;
}

.send-error {
  margin: 8rpx 0 20rpx;
  color: #b1433f;
  font-size: 24rpx;
}

.input-bar {
  flex-shrink: 0;
  background: #ffffff;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #efede8;
}

.selected-item-wrap {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  margin-bottom: 12rpx;
}

.selected-item {
  max-width: 520rpx;
  padding: 10rpx 20rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #efede8;
  color: #514d47;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-item-remove {
  margin-left: 10rpx;
  color: #9a958c;
  font-size: 34rpx;
  line-height: 1;
}

.image-preview-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 12rpx;
}

.image-preview {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #c0504d;
  color: #ffffff;
  font-size: 24rpx;
}

.input-row {
  display: flex;
  align-items: center;
}

.image-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.image-icon {
  width: 40rpx;
  height: 40rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f6f4f0;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #3a3835;
  color: #ffffff;
  font-size: 28rpx;
  flex-shrink: 0;
}

.send-disabled {
  opacity: 0.4;
}
