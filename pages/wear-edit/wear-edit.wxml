<view class="page" bindtouchstart="onSwipeBackStart" bindtouchend="onSwipeBackEnd">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{loadError}}" class="empty">{{loadError}}<button bindtap="onRetry">重新加载</button></view>

  <view wx:if="{{historyEditing}}" class="history-edit-mask {{historyClosing ? 'history-edit-mask-closing' : ''}}" catchtap="onCancelHistoryEdit" catchtouchmove="onHistoryEditTouch"></view>
  <view wx:if="{{!loading && !loadError}}" class="wear-form {{historyEditing ? 'history-edit-panel' : ''}} {{historyClosing ? 'history-edit-closing' : ''}}" aria-role="{{historyEditing ? 'dialog' : ''}}" aria-label="{{historyEditing ? '编辑实穿' : ''}}">
    <view wx:if="{{historyEditing}}" class="history-edit-heading" catchtouchmove="onHistoryEditTouch">编辑实穿</view>
    <scroll-view class="wear-form-body" scroll-y="{{historyEditing}}" enhanced show-scrollbar="{{false}}">
      <view class="wear-form-content">
  <!-- 日期摘要条：默认今天，点按才打开滚轮补记 -->
  <view wx:if="{{!loading && !loadError}}" class="date-row card" data-target="date" bindtap="openPicker">
    <text class="date-row-label">日期</text>
    <text class="date-row-value">{{dateText}}</text>
    <text class="date-row-arrow">›</text>
  </view>
  <view wx:if="{{!historyEnabled && !loading && !loadError}}" class="date-row card" data-target="outfit" bindtap="openPicker">
    <text class="date-row-label">穿搭</text>
    <text class="date-row-value {{outfitName ? '' : 'placeholder'}}">{{outfitName || '可选，选穿搭自动带出单品'}}</text>
    <text class="date-row-arrow">›</text>
  </view>

  <view wx:if="{{historyEnabled && !loading && !loadError}}" class="quick-row">
    <text class="quick-label">快速带入</text>
    <button class="quick-btn" bindtap="onLastWearTap">上次实穿</button>
    <button class="quick-btn {{outfitName ? 'quick-btn-on' : ''}}" data-target="outfit" bindtap="openPicker">{{outfitName || '从穿搭'}}</button>
  </view>
  <view wx:if="{{itemRefreshError}}" class="stock-error" bindtap="refreshItemsAfterQuickAdd">{{itemRefreshError}}</view>
  <view wx:if="{{recentlyAdded.length}}" class="new-items">
    <text>刚入库，点选加入：</text>
    <button wx:for="{{recentlyAdded}}" wx:key="_id" class="new-item {{item.selected ? 'new-item-selected' : ''}}" data-id="{{item._id}}" bindtap="onItemToggle">{{item.selected ? '✓' : '+'}} {{item.name || '未命名'}}</button>
  </view>

  <view wx:if="{{!loading && !loadError && quickPicks.length}}" class="quick-picks">
    <view class="quick-picks-label">常穿（近 14 天，点选加入）</view>
    <scroll-view scroll-x class="quick-picks-scroll" enhanced show-scrollbar="{{false}}">
      <view class="quick-picks-inner">
        <view
          wx:for="{{quickPicks}}"
          wx:key="_id"
          class="pick-chip {{item.selected ? 'pick-chip-on' : ''}}"
          data-id="{{item._id}}"
          bindtap="onItemToggle"
        >{{item.name || '未命名'}}<text class="pick-chip-count">{{item.count}}</text></view>
      </view>
    </scroll-view>
  </view>

  <!-- 选择衣物：分类切换条 + 多选网格 -->
  <scroll-view wx:if="{{!loading && !loadError}}" scroll-x class="cat-bar" enhanced show-scrollbar="{{false}}">
    <view class="cat-bar-inner">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="cat-chip {{activeCategory === item ? 'cat-chip-active' : ''}}"
        data-value="{{item}}"
        bindtap="onCategoryTap"
      >{{item}}</view>
    </view>
  </scroll-view>
  <view wx:if="{{!loading && !loadError}}" class="section-title">
    <text>穿过的衣物（已选 {{selectedIds.length}} 件）</text>
    <button wx:if="{{historyEnabled}}" class="inline-add" bindtap="onQuickAddTap" disabled="{{saving || refreshingItems || !ready}}">+ 快捷入库</button>
  </view>
  <block wx:if="{{!loading && !loadError}}">
    <view wx:if="{{items.length === 0}}" class="empty">{{historyEnabled ? '衣橱里还没有衣物，可点上方「+ 快捷入库」添加' : '衣橱里还没有衣物，请先去「衣物」页添加'}}</view>
    <view wx:elif="{{viewItems.length === 0}}" class="empty">{{activeCategory === '已选' ? '还没有选中任何衣物' : '该分类下还没有衣物'}}</view>
    <view wx:else class="grid">
      <view
        wx:for="{{viewItems}}"
        wx:key="_id"
        class="pick-card {{item.selected ? 'pick-selected' : ''}}"
        data-id="{{item._id}}"
        bindtap="onItemToggle"
      >
        <image wx:if="{{item.imageFileID}}" class="pick-image" src="{{item.imageFileID}}" mode="aspectFill" />
        <view wx:else class="pick-image pick-placeholder">无图</view>
        <view class="pick-name">{{item.name}}</view>
        <view wx:if="{{item.selected}}" class="check">✓</view>
      </view>
    </view>

    <!-- 单行备注：与「我的穿搭」快速录入同位置，可选 -->
    <view class="form card note-card">
      <view class="field">
        <text class="label">备注</text>
        <input class="input" placeholder="{{_focus.note ? '' : '还有些什么……'}}" value="{{note}}" data-field="note" bindinput="onNoteInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" />
      </view>
    </view>

    <view wx:if="{{missingCount}}" class="missing card">
      <text>这条旧记录有 {{missingCount}} 件衣物已从衣橱删除</text>
      <button bindtap="onRemoveMissing">移除失效衣物</button>
    </view>

    <view wx:if="{{outfitSyncError}}" class="stock-error" bindtap="refreshAfterOutfitEdit">{{outfitSyncError}}</view>
    <button wx:if="{{!historyEditing}}" class="btn-primary save-btn" bindtap="onSave" disabled="{{saving || !ready || outfitSyncPending || outfitSyncError}}">保存</button>
    <view wx:if="{{historyEnabled}}" class="save-outfit-link {{saving || !ready || outfitSyncPending || outfitSyncError ? 'save-outfit-link-off' : ''}}" bindtap="onSaveAsOutfit">保存并记为穿搭 ›</view>
    <button wx:if="{{id}}" class="btn-danger delete-btn" bindtap="onDelete" disabled="{{saving || !ready}}">删除</button>
    <button wx:if="{{id && historyEnabled && !historyEditing}}" class="reset-btn" bindtap="onResetTap" disabled="{{saving}}">返回今日录入</button>
  </block>
      </view>
    </scroll-view>
    <view wx:if="{{historyEditing}}" class="history-edit-actions" catchtouchmove="onHistoryEditTouch">
      <button class="history-edit-cancel" bindtap="onCancelHistoryEdit" disabled="{{saving || historyClosing}}">取消</button>
      <button class="btn-primary save-btn" bindtap="onSave" disabled="{{saving || historyClosing || !ready || outfitSyncPending || outfitSyncError}}">保存修改</button>
    </view>
  </view>

    <block wx:if="{{historyEnabled && !loading && !loadError}}">
    <view class="history-heading">近期实穿</view>
    <view wx:if="{{historyError}}" class="history-empty" bindtap="refreshHistory">{{historyError}}</view>
    <view wx:elif="{{history.length === 0}}" class="history-empty">还没有实穿记录，保存后会显示在这里</view>
    <view wx:for="{{history}}" wx:for-item="record" wx:key="_id" class="history-card card" data-id="{{record._id}}" bindtap="onHistoryTap">
      <view class="history-head">
        <text class="history-date">{{record.date}}</text>
        <text wx:if="{{record.future}}" class="future-label">未来日期待修正</text>
        <text class="history-count">{{record.itemCount}} 件</text>
      </view>
      <view class="history-body">
        <view class="history-images">
          <image wx:for="{{record.thumbs}}" wx:for-item="thumb" wx:key="_id" src="{{thumb.imageFileID}}" mode="aspectFill" />
        </view>
        <text class="history-names">{{record.itemNames}}</text>
      </view>
      <view wx:if="{{record.note}}" class="history-note">{{record.note}}</view>
      <view class="history-actions">
        <text>编辑记录</text>
        <button data-id="{{record._id}}" catchtap="onHistoryDelete">删除</button>
      </view>
    </view>
    <button wx:if="{{hasMoreHistory}}" class="more-btn" bindtap="onMoreHistory">加载更多记录</button>
    </block>

  <wheel-picker
    show="{{picker.show}}"
    title="{{picker.title}}"
    columns="{{picker.columns}}"
    values="{{picker.values}}"
    bind:confirm="onPickerConfirm"
    bind:cancel="onPickerCancel"
    bind:columnchange="onPickerColumnChange"
  />
</view>
