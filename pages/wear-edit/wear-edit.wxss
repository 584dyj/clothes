.page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.history-edit-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.4);
  animation: history-mask-in 300ms ease-out both;
}

.history-edit-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 81;
  display: flex;
  flex-direction: column;
  height: 88vh;
  border-radius: 28rpx 28rpx 0 0;
  background: #f6f4f0;
  overflow: hidden;
  animation: history-panel-in 300ms ease-out both;
}

.history-edit-mask-closing { animation: history-mask-out 300ms ease-in both; }
.history-edit-closing { animation: history-panel-out 300ms ease-in both; pointer-events: none; }
@keyframes history-panel-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes history-panel-out { from { transform: translateY(0); } to { transform: translateY(100%); } }
@keyframes history-mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes history-mask-out { from { opacity: 1; } to { opacity: 0; } }

.history-edit-heading {
  flex-shrink: 0;
  padding: 28rpx 32rpx 24rpx;
  color: #3a3835;
  font-size: 32rpx;
  font-weight: 600;
}

.history-edit-panel .wear-form-body {
  flex: 1;
  height: 0;
  min-height: 0;
}

.history-edit-panel .wear-form-content {
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.history-edit-actions {
  display: flex;
  flex-shrink: 0;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e9e5de;
  background: #f6f4f0;
}

.history-edit-actions button {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 44rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.history-edit-cancel {
  background: #ffffff;
  color: #6b675f;
}

/* 日期/穿搭摘要条：一行卡片，点按打开滚轮 */
.date-row {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
}

.date-row-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #6b675f;
  font-size: 28rpx;
}

.date-row-value {
  flex: 1;
  font-size: 28rpx;
}

.date-row-arrow {
  color: #b3aea5;
  font-size: 30rpx;
}

.form {
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #efede8;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  color: #6b675f;
  font-size: 28rpx;
  flex-shrink: 0;
}

.placeholder {
  color: #b3aea5;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.note-card {
  margin-bottom: 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #6b675f;
  margin: 8rpx 8rpx 20rpx;
}

.inline-add {
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  background: #3a3835;
  color: #ffffff;
  font-size: 24rpx;
}

.inline-add[disabled] {
  opacity: 0.5;
}

/* 分类切换条：横向滚动，单选 */
.cat-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-bar-inner {
  display: inline-flex;
}

.cat-chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #6b675f;
  font-size: 26rpx;
}

.cat-chip-active {
  background: #3a3835;
  color: #ffffff;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}

.pick-card {
  position: relative;
  width: 31%;
  margin: 0 1.1% 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #ffffff;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.pick-selected {
  border-color: #3a3835;
}

.pick-image {
  width: 100%;
  height: 290rpx; /* 3:4 竖版 */
  display: block;
}

.pick-placeholder {
  background: #efede8;
  color: #9a958c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.pick-name {
  padding: 10rpx 14rpx;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #3a3835;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.wear-form-content .save-btn {
  width: 100%;
  margin: 0 0 24rpx;
  box-sizing: border-box;
}

/* 「保存并记为穿搭」降级为文字链接，不抢主按钮 */
.save-outfit-link { margin: -4rpx 0 32rpx; text-align: center; color: #6b675f; font-size: 26rpx; }
.save-outfit-link-off { opacity: 0.5; }

.quick-row { display: flex; align-items: center; gap: 16rpx; margin: 0 8rpx 24rpx; }
.quick-label { flex-shrink: 0; color: #9a958c; font-size: 24rpx; }
.quick-btn { margin: 0; padding: 0 24rpx; height: 64rpx; line-height: 64rpx; border-radius: 32rpx; background: #ffffff; color: #3a3835; font-size: 25rpx; max-width: 340rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quick-btn-on { background: #3a3835; color: #ffffff; }
.quick-btn::after, .inline-add::after, .new-item::after, .missing button::after, .history-actions button::after, .reset-btn::after, .more-btn::after { border: none; }
.stock-error { margin: 0 8rpx 16rpx; color: #c0504d; font-size: 24rpx; }
.new-items { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin: 0 8rpx 24rpx; color: #6b675f; font-size: 24rpx; }
.new-item { margin: 0; padding: 0 16rpx; height: 60rpx; line-height: 60rpx; border-radius: 30rpx; background: #ffffff; color: #3a3835; font-size: 24rpx; }
.new-item-selected { background: #3a3835; color: #ffffff; }
.quick-picks { margin: 0 8rpx 24rpx; }
.quick-picks-label { margin-bottom: 12rpx; color: #9a958c; font-size: 24rpx; }
.quick-picks-scroll { white-space: nowrap; }
.quick-picks-inner { display: inline-flex; }
.pick-chip { display: inline-flex; align-items: center; padding: 10rpx 24rpx; margin-right: 16rpx; border-radius: 32rpx; background: #ffffff; color: #3a3835; font-size: 25rpx; }
.pick-chip-on { background: #3a3835; color: #ffffff; }
.pick-chip-count { margin-left: 8rpx; color: #9a958c; font-size: 22rpx; }
.pick-chip-on .pick-chip-count { color: #cfcbc4; }
.missing { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 22rpx; margin-bottom: 24rpx; color: #6b675f; font-size: 24rpx; }
.missing button { margin: 0; padding: 0 12rpx; background: transparent; color: #3a3835; font-size: 24rpx; }
.reset-btn { margin-bottom: 48rpx; background: transparent; color: #6b675f; font-size: 26rpx; }
.history-heading { margin: 48rpx 6rpx 22rpx; font-size: 30rpx; font-weight: 600; color: #3a3835; }
.history-empty { padding: 34rpx 20rpx; text-align: center; color: #9a958c; font-size: 25rpx; }
.history-card { padding: 22rpx 24rpx; margin-bottom: 18rpx; }
.history-head, .history-body, .history-actions { display: flex; align-items: center; }
.history-date { font-size: 28rpx; font-weight: 600; }
.history-count { margin-left: auto; color: #9a958c; font-size: 24rpx; }
.future-label { margin-left: 16rpx; color: #c0504d; font-size: 22rpx; }
.history-body { margin-top: 18rpx; gap: 18rpx; }
.history-images { display: flex; flex-shrink: 0; }
.history-images image { width: 64rpx; height: 64rpx; margin-right: 6rpx; border-radius: 8rpx; }
.history-names { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #6b675f; font-size: 25rpx; }
.history-note { margin-top: 12rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #9a958c; font-size: 24rpx; }
.history-actions { justify-content: space-between; margin-top: 16rpx; color: #9a958c; font-size: 22rpx; }
.history-actions button { margin: 0; padding: 0 26rpx; height: 52rpx; line-height: 52rpx; border: 2rpx solid #c0504d; border-radius: 26rpx; background: #ffffff; color: #c0504d; font-size: 24rpx; }
.more-btn { background: transparent; color: #6b675f; font-size: 25rpx; }
