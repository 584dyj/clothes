.mp {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
}

.mp-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.mp-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.mp-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #efede8;
}

.mp-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #3a3835;
}

.mp-btn {
  font-size: 30rpx;
  color: #9a958c;
  padding: 8rpx 16rpx;
}

.mp-confirm {
  color: #3a3835;
  font-weight: 600;
}

.mp-options {
  display: flex;
  flex-wrap: wrap;
  padding: 28rpx 32rpx 8rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.mp-opt {
  padding: 14rpx 32rpx;
  margin: 0 20rpx 20rpx 0;
  border-radius: 32rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 30rpx;
}

.mp-options-grid {
  gap: 16rpx;
}

.mp-options-grid .mp-opt {
  flex: 0 0 calc((100% - 48rpx) / 4);
  min-width: 0;
  box-sizing: border-box;
  padding: 14rpx 8rpx;
  margin: 0;
  text-align: center;
  white-space: nowrap;
}

.mp-opt-active {
  background: #3a3835;
  color: #ffffff;
}

.mp-hint {
  padding: 0 32rpx 12rpx;
  color: #b3aea5;
  font-size: 24rpx;
}
