.batch-panel {
  display: block;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.toolbar-text {
  flex: 1;
  min-width: 0;
}

.toolbar-title {
  font-size: 32rpx;
  font-weight: 600;
  white-space: nowrap;
}

.toolbar-hint, .summary-meta {
  margin-top: 8rpx;
  color: #9a958c;
  font-size: 24rpx;
}

.toolbar-hint {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.choose-btn {
  flex-shrink: 0;
  margin: 0 0 0 24rpx;
  background: #3a3835;
  color: #ffffff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-height: calc(100vh - 300rpx);
  padding: 180rpx 0 120rpx;
  box-sizing: border-box;
}

.empty-text {
  width: 100%;
  color: #9a958c;
  font-size: 26rpx;
  text-align: center;
  white-space: nowrap;
}

.empty-choose {
  width: 420rpx;
  margin: auto 0 0;
  background: #3a3835;
  color: #ffffff;
}

.batch-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.batch-card {
  position: relative;
  width: 48.5%;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.card-expanded {
  width: 100%;
}

.card-saved {
  opacity: 0.65;
}

.card-remove {
  position: absolute;
  z-index: 2;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(58, 56, 53, 0.55);
  color: #ffffff;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
}

.card-summary {
  display: flex;
  padding: 16rpx;
}

.card-image {
  width: 128rpx;
  height: 170rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: #efede8;
}

.summary-text {
  min-width: 0;
  padding-left: 16rpx;
}

.summary-name {
  overflow: hidden;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  display: inline-block;
  margin-top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 22rpx;
}

.status-failed, .card-error { color: #c0504d; }
.status-saved { color: #397d4d; }

.card-error {
  padding: 0 16rpx 16rpx;
  font-size: 24rpx;
}

.card-actions {
  padding: 0 16rpx 16rpx;
}

.card-actions button {
  margin: 0;
}

.editor {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #efede8;
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #efede8;
}

.field-column {
  align-items: flex-start;
  flex-direction: column;
}

.label {
  width: 160rpx;
  flex-shrink: 0;
  color: #6b675f;
}

.input { flex: 1; }

.brand-suggestions { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 16rpx 0; }
.brand-suggestions button { margin: 0; max-width: 100%; white-space: normal; word-break: break-all; background: #efede8; color: #6b675f; }

.picker-value {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #efede8;
  color: #6b675f;
  font-size: 25rpx;
}

.chip-active {
  background: #3a3835;
  color: #ffffff;
}

.placeholder { color: #b3aea5; }

.save-btn {
  width: 100%;
  margin: 20rpx 0 0;
  background: #3a3835;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
